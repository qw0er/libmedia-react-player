{
  "name": "libmedia-react-player",
  "version": "1.6.1",
  "description": "A React player for Matroska built on libmedia AVPlayer, with chapter navigation and audio and subtitle track selection.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qw0er/libmedia-react-player.git"
  },
  "keywords": [
    "react",
    "video-player",
    "libmedia",
    "matroska",
    "mkv",
    "webassembly"
  ],
  "type": "module",
  "scripts": {
    "setup:libmedia": "git submodule update --init --recursive && npm --prefix deps/libmedia ci --ignore-scripts && npm run build:libmedia",
    "build:libmedia": "npm --prefix deps/libmedia run build-avplayer-browser",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc -b",
    "check": "biome check . && npm run typecheck && npm test",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.77.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jassub": "2.5.38",
    "jsdom": "^31.0.1",
    "libbitsub": "1.13.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "files": [
    "dist",
    "!dist/src/**",
    "dist/src/LibmediaPlayer.d.ts",
    "dist/src/player-api.d.ts",
    "LICENSE-GPL-3.0",
    "LICENSE-LGPL-3.0"
  ],
  "types": "./dist/src/LibmediaPlayer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/LibmediaPlayer.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
