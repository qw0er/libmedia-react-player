{
  "name": "libmedia-react-player",
  "version": "1.1.0",
  "description": "A React player for Matroska built on libmedia AVPlayer, with chapter navigation and audio and subtitle track selection.",
  "license": "LGPL-3.0-or-later",
  "keywords": [
    "react",
    "video-player",
    "libmedia",
    "matroska",
    "mkv",
    "webassembly"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc -b",
    "check": "biome check . && npm run typecheck",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@libmedia/avplayer": "1.3.1",
    "lucide-react": "^1.77.0",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.6.8",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jassub": "2.5.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "files": [
    "dist",
    "COPYING"
  ],
  "types": "./dist/src/LibmediaPlayer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/LibmediaPlayer.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
